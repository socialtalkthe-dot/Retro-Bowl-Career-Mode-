rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Safety Net: Master default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidLeague(val) {
      return val is string && val in ['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'All-Pro', 'Retro Legend'];
    }

    function isValidPosition(val) {
      return val is string && val in ['QB', 'RB', 'WR', 'TE', 'OL', 'DL', 'LB', 'CB', 'S', 'K'];
    }

    // Pillar 2: Strict entity validation helpers matching firebase-blueprint.json
    function isValidRankingProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'displayName', 'region', 'countryCode', 'favoriteTeamId',
          'onlineElo', 'onlineWins', 'onlineLosses', 'onlineLeague',
          'legacyScore', 'careerLeague', 'careerTitles', 'careerYards',
          'careerTDs', 'careerGames', 'position', 'starRating', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'region', 'countryCode', 'favoriteTeamId',
          'onlineElo', 'onlineWins', 'onlineLosses', 'onlineLeague',
          'legacyScore', 'careerLeague', 'careerTitles', 'careerYards',
          'careerTDs', 'careerGames', 'position', 'starRating', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && data.region is string && data.region in ['US', 'INTL']
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4 && data.countryCode.matches('^[A-Z]{2,4}$')
        && data.favoriteTeamId is string && data.favoriteTeamId.size() >= 1 && data.favoriteTeamId.size() <= 64
        && data.onlineElo is number && data.onlineElo >= 100 && data.onlineElo <= 4000
        && data.onlineWins is int && data.onlineWins >= 0 && data.onlineWins <= 100000
        && data.onlineLosses is int && data.onlineLosses >= 0 && data.onlineLosses <= 100000
        && isValidLeague(data.onlineLeague)
        && data.legacyScore is int && data.legacyScore >= 0 && data.legacyScore <= 100000
        && isValidLeague(data.careerLeague)
        && data.careerTitles is int && data.careerTitles >= 0 && data.careerTitles <= 100
        && data.careerYards is int && data.careerYards >= 0 && data.careerYards <= 500000
        && data.careerTDs is int && data.careerTDs >= 0 && data.careerTDs <= 5000
        && data.careerGames is int && data.careerGames >= 0 && data.careerGames <= 1000
        && isValidPosition(data.position)
        && data.starRating is number && data.starRating >= 1.0 && data.starRating <= 5.0
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'preferredRegion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'preferredRegion', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.preferredRegion is string && data.preferredRegion in ['US', 'INTL']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineMatchRecord(data, matchId) {
      return data.keys().hasAll([
          'matchId', 'hostUid', 'mode', 'homeTeamName', 'awayTeamName',
          'homeScore', 'awayScore', 'participantUids', 'createdAt'
        ])
        && data.keys().hasOnly([
          'matchId', 'hostUid', 'mode', 'homeTeamName', 'awayTeamName',
          'homeScore', 'awayScore', 'participantUids', 'createdAt'
        ])
        && isValidId(data.matchId)
        && data.matchId == matchId
        && isValidId(data.hostUid)
        && data.hostUid == request.auth.uid
        && data.mode is string && data.mode in ['COOP_VS_PVP', 'SOLO_PVP']
        && data.homeTeamName is string && data.homeTeamName.size() >= 1 && data.homeTeamName.size() <= 48
        && data.awayTeamName is string && data.awayTeamName.size() >= 1 && data.awayTeamName.size() <= 48
        && data.homeScore is int && data.homeScore >= 0 && data.homeScore <= 200
        && data.awayScore is int && data.awayScore >= 0 && data.awayScore <= 200
        && data.participantUids is list
        && data.participantUids.size() >= 1 && data.participantUids.size() <= 10
        && data.participantUids[0] is string
        && request.auth.uid in data.participantUids
        && data.createdAt is timestamp;
    }

    // Public non-PII global US & International rankings
    match /rankings/{uid} {
      allow get: if isValidId(uid) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true && request.query.limit != null && request.query.limit <= 100;

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidRankingProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidRankingProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'region', 'countryCode', 'favoriteTeamId',
          'onlineElo', 'onlineWins', 'onlineLosses', 'onlineLeague',
          'legacyScore', 'careerLeague', 'careerTitles', 'careerYards',
          'careerTDs', 'careerGames', 'position', 'starRating', 'isPublic',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() && isValidId(uid) && isOwner(uid);
    }

    // Owner-isolated private PII profile
    match /users/{uid}/private/{docId} {
      allow get: if isValidId(uid) && isValidId(docId) && docId == 'profile' && isOwner(uid);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isValidId(docId)
        && docId == 'profile'
        && isOwner(uid)
        && isValidUserPrivateProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidId(docId)
        && docId == 'profile'
        && isOwner(uid)
        && isValidUserPrivateProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'preferredRegion', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(uid) && isValidId(docId) && docId == 'profile' && isOwner(uid);
    }

    // Immutable completed online multiplayer match logs scoped to participants
    match /onlineMatches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids && request.query.limit != null && request.query.limit <= 50;

      allow create: if isVerifiedUser()
        && isValidId(matchId)
        && isValidOnlineMatchRecord(incoming(), matchId)
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
